{
  "name": "petey-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:third-space": "vite --config vite.third-space.config.ts",
    "dev:third-space-admin": "vite --config vite.third-space-admin.config.ts",
    "build:third-space-admin": "tsc -b && vite build --config vite.third-space-admin.config.ts",
    "preview:third-space-admin": "vite preview --config vite.third-space-admin.config.ts",
    "build:third-space": "tsc -b && vite build --config vite.third-space.config.ts",
    "preview:third-space": "vite preview --config vite.third-space.config.ts",
    "verify:third-space": "npm run lint && npm run typecheck && vitest run src/third-space-demo && npm run build:third-space && npm --prefix functions-third-space run build && npm --prefix functions-third-space test && node scripts/validate-third-space.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions run test",
    "forms:test": "node --test apps-script/trainer-applications/Code.test.mjs",
    "reset:user-data": "npm --prefix functions run reset:user-data --",
    "verify": "npm run lint && npm run typecheck && vitest run && vite build && npm run functions:build && npm run functions:test && npm run forms:test",
    "test:marketplace": "npx -y firebase-tools@latest --config firebase.marketplace-tests.json emulators:exec --project demo-petey-rules --only auth,firestore,storage \"node scripts/verify-marketplace.mjs\"",
    "dev:marketplace-qa": "npm run functions:build && node scripts/marketplace-qa-server.mjs",
    "dev:david-lloyd": "vite --config vite.david-lloyd.config.ts",
    "dev:david-lloyd-admin": "vite --config vite.david-lloyd-admin.config.ts",
    "build:david-lloyd": "tsc -b && vite build --config vite.david-lloyd.config.ts",
    "build:david-lloyd-admin": "tsc -b && vite build --config vite.david-lloyd-admin.config.ts",
    "preview:david-lloyd": "vite preview --config vite.david-lloyd.config.ts",
    "preview:david-lloyd-admin": "vite preview --config vite.david-lloyd-admin.config.ts",
    "verify:david-lloyd": "npm run lint && npm run typecheck && vitest run src/david-lloyd-demo src/david-lloyd-demo-admin && npm run build:david-lloyd && npm run build:david-lloyd-admin && npm --prefix functions-david-lloyd run build && npm --prefix functions-david-lloyd test && node scripts/validate-david-lloyd.mjs",
    "verify:david-lloyd:hosted": "node scripts/verify-david-lloyd-hosted.mjs --run",
    "dev:gymbox": "vite --config vite.gymbox.config.ts",
    "dev:gymbox-admin": "vite --config vite.gymbox-admin.config.ts",
    "build:gymbox": "tsc -b && vite build --config vite.gymbox.config.ts",
    "build:gymbox-admin": "tsc -b && vite build --config vite.gymbox-admin.config.ts",
    "preview:gymbox": "vite preview --config vite.gymbox.config.ts",
    "preview:gymbox-admin": "vite preview --config vite.gymbox-admin.config.ts",
    "verify:gymbox": "npm run lint && npm run typecheck && vitest run src/gymbox-demo src/gymbox-demo-admin && npm run build:gymbox && npm run build:gymbox-admin && npm --prefix functions-gymbox run build && npm --prefix functions-gymbox test && node scripts/validate-gymbox.mjs",
    "verify:gymbox:hosted": "node scripts/verify-gymbox-hosted.mjs --run"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oxygen": "^5.3.0",
    "d3-shape": "^3.2.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
