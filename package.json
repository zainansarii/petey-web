{
  "name": "petey-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions run test",
    "forms:test": "node --test apps-script/trainer-applications/Code.test.mjs",
    "reset:user-data": "npm --prefix functions run reset:user-data --",
    "verify": "npm run lint && npm run typecheck && vitest run && vite build && npm run functions:build && npm run functions:test && npm run forms:test",
    "test:marketplace": "npx -y firebase-tools@latest --config firebase.marketplace-tests.json emulators:exec --project demo-petey-rules --only auth,firestore,storage \"node scripts/verify-marketplace.mjs\"",
    "dev:marketplace-qa": "npm run functions:build && node scripts/marketplace-qa-server.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@fontsource/oxygen": "^5.3.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
